# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/shareplate?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=replace_with_a_secure_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d
